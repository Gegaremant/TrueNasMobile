<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy auto-backup rules (devices below API 31).
   Mirrors res/xml/data_extraction_rules.xml: all secret-bearing DataStore
   files are excluded so API keys / passwords / session tokens are never
   uploaded to the user's cloud backup.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/secure_preferences.preferences_pb" />
    <exclude domain="file" path="datastore/multi_account_preferences.preferences_pb" />
    <exclude domain="file" path="datastore/push_preferences.preferences_pb" />
</full-backup-content>
