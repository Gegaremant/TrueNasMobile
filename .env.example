# ─────────────────────────────────────────────────────────────────────────────
# TrueNasMobile — local secrets
#
# Copy to `.env` in the repo root and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Nothing here is a
# placeholder that works: the app reads these from the environment / the
# Gradle build, never from source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub remote ───────────────────────────────────────────────────────────
# Used only to push to the private repo. The token lives in .git/config and
# nowhere else; .env keeps a copy for scripted use.
Git_repo=https://github.com/Gegaremant/TrueNasMobile.git
Git_token=ghp_REPLACE_ME

# ── Release signing ─────────────────────────────────────────────────────────
# Local builds: point at a keystore that lives OUTSIDE the repository.
KEYSTORE_PATH=/home/you/keystores/truenasmobile-release.jks
KEYSTORE_ALIAS=truenasmobile
KEYSTORE_PASSWORD=change-me

# CI builds: no file on disk, so hand the keystore over as base64 instead.
#   base64 -w0 truenasmobile-release.jks
# KEYSTORE_BASE64=MIIJ...base64...

# ── Test instance (optional, for manual smoke tests only) ────────────────────
TrueNas_test_ip=192.0.2.10
TrueNas_test_web_port=443
TrueNas_test_ssh_port=22
TrueNas_test_user=example_admin
TrueNas_test_pass=change-me
